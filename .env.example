# Google Gen AI transport:
# - Vertex AI / ADC: set true, set project/location, and leave both keys blank.
# - Developer API or custom gateway: leave false and set one API key.
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite

# Optional Developer-API-compatible gateway. It cannot be combined with Vertex AI.
GEMINI_BASE_URL=
# GEMINI_API_KEY/GOOGLE_API_KEY is used for the default endpoint or gateway.
# Optional planner-phase override. Leave blank to use GEMINI_MODEL.
# Example: gemini-3.8-flash-medium
GEMINI_SYSTEM_MAP_MODEL=

# Low-latency onboarding / Goal merge routing.
GEMINI_GOAL_MODEL=gemini-3.5-flash-lite
GEMINI_GOAL_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash,gemini-3.6-flash,gemini-3.8-flash
GEMINI_GOAL_MODEL_TIMEOUT_SECONDS=8
ARCHBRO_GOAL_REQUEST_TIMEOUT_SECONDS=30

# High-frequency, low-risk project state updates.
GEMINI_ROUTINE_MODEL=gemini-3.5-flash-lite
GEMINI_ROUTINE_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash,gemini-3.6-flash,gemini-3.8-flash
GEMINI_ROUTINE_MODEL_TIMEOUT_SECONDS=8
GEMINI_INTERACTION_MODEL_TIMEOUT_SECONDS=12
GEMINI_INTERACTION_TOTAL_TIMEOUT_SECONDS=36

ARCHBRO_PROVIDER=gemini

# Authentication: the local principal is for local/test only. Production fails
# closed unless verified Firebase bearer tokens are enabled.
ARCHBRO_ENV=local
ARCHBRO_AUTH_MODE=local
ARCHBRO_FIREBASE_API_KEY=
ARCHBRO_FIREBASE_AUTH_DOMAIN=
ARCHBRO_FIREBASE_APP_ID=

# Persistence: PostgreSQL is the only backend. `postgres` is the default, and
# DATABASE_URL is required -- the app refuses to start without it. Under
# docker-compose.yml, DATABASE_URL is assembled from the POSTGRES_* values at
# the bottom of this file, so setting it here has no effect on the app
# container; set it directly only when running outside Compose.
ARCHBRO_PERSISTENCE=postgres
# DATABASE_URL=postgresql://<redacted>@127.0.0.1:5432/archbro
FIREBASE_PROJECT_ID=
# GOOGLE_CLOUD_PROJECT above is also accepted as the Firebase project alias.

# Generic external MCP gateway. Endpoints are server-side deployment config,
# never browser-supplied URLs. Each source requires an explicit tool allowlist.
# Example:
# ARCHBRO_MCP_SERVERS_JSON=[{"id":"github","name":"GitHub","url":"https://example.com/mcp","auth_token_env":"GITHUB_MCP_TOKEN","allow_tools":["search_*","get_*","list_*"]}]
ARCHBRO_MCP_SERVERS_JSON=[]

# Repositories the pull-based pipeline watches. connector_id must match an MCP
# server id above. repository_id is GitHub's numeric id, not owner/name: it is
# the replay key's qualifier and must never have a second spelling. Example:
# ARCHBRO_GITHUB_CONNECTORS_JSON=[{"project_id":"proj_1","connector_id":"github","repository_id":987654321,"repository":"Magic-Dala/archbro","branch":"main"}]
ARCHBRO_GITHUB_CONNECTORS_JSON=[]

# How often the deployed connector worker runs one pass. Connecting a
# repository takes a baseline rather than replaying its history: those commits
# predate the architecture they would be evaluated against, so the evaluation
# cannot mean anything and a real repository would cost thousands of model
# calls to walk.
ARCHBRO_CONNECTOR_INTERVAL_SECONDS=300

# Human-controlled first-party MCP provider sign-in. Access and refresh tokens
# stay backend-only and are encrypted in PostgreSQL, scoped to the authenticated
# ArchBro principal. Generate one stable Fernet key per deployed stack and keep it
# across releases. For online rotation, set new-key,old-key; new writes use the
# first key and rows read through an old key are rewrapped automatically. Remove
# old keys only after migration/acceptance proves every credential was rewrapped.
# Losing every matching key requires affected users to reconnect:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ARCHBRO_PROVIDER_CREDENTIAL_KEY=
# Session-only local GitHub/Google helper runtimes are disabled by default in
# deployed environments because container recreation discards them. This escape
# hatch is intended only for local diagnosis, never as the user-facing path.
ARCHBRO_ALLOW_EPHEMERAL_PROVIDER_OAUTH=false
# Custom browser-supplied MCP endpoints remain local-development only.
ARCHBRO_GITHUB_OAUTH_CLIENT_ID=
ARCHBRO_GITHUB_OAUTH_CLIENT_SECRET=
ARCHBRO_GOOGLE_DRIVE_OAUTH_CLIENT_ID=
ARCHBRO_GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
ARCHBRO_SLACK_OAUTH_CLIENT_ID=
ARCHBRO_SLACK_OAUTH_CLIENT_SECRET=
ARCHBRO_MICROSOFT_TEAMS_CLIENT_ID=
ARCHBRO_MICROSOFT_TEAMS_CLIENT_SECRET=
ARCHBRO_MICROSOFT_TEAMS_TENANT_ID=
# Teams is read-only by default. Enable only when ArchBro must send messages.
ARCHBRO_TEAMS_ENABLE_WRITE=false
# Preferred for public deployments: pin every provider callback to the intended
# public ArchBro origin instead of deriving it from the incoming request host.
# Example: https://archbro-dev.magicdala.com
ARCHBRO_OAUTH_REDIRECT_BASE_URL=
# Local Slack OAuth cannot return to localhost, so local development may borrow
# the live dev host when the generic public redirect base above is unset.
ARCHBRO_SLACK_OAUTH_REDIRECT_BASE_URL=https://archbro-dev.magicdala.com
ARCHBRO_LOCAL_UI_ORIGIN=http://127.0.0.1:8012

# Bounded high-quality reasoning / initial architecture.
GEMINI_ARCHITECTURE_MODEL_TIMEOUT_SECONDS=90
GEMINI_ARCHITECTURE_PHASE_TIMEOUT_SECONDS=120
GEMINI_ARCHITECTURE_TOTAL_TIMEOUT_SECONDS=900
GEMINI_ARCHITECTURE_HTTP_TIMEOUT_MS=90000
# Hard ceiling plus phase-specific starting budgets. The small topology passes
# begin well below the model's 65K ceiling and expand only after an explicit
# MAX_TOKENS result, without replaying already-completed phases.
GEMINI_ARCHITECTURE_MAX_OUTPUT_TOKENS=65536
GEMINI_SYSTEM_MAP_MAX_OUTPUT_TOKENS=4096
GEMINI_SCOPE_MAX_OUTPUT_TOKENS=8192
GEMINI_RECONCILE_MAX_OUTPUT_TOKENS=16384
GEMINI_ARCHITECTURE_THINKING_LEVEL=medium
GEMINI_SYSTEM_MAP_THINKING_LEVEL=low
GEMINI_SCOPE_THINKING_LEVEL=low
GEMINI_RECONCILE_THINKING_LEVEL=medium
GEMINI_BOOTSTRAP_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.5-flash

# Bounded same-model planner retry with exponential backoff/full jitter.
# The SDK stays at one attempt so ambiguous transport timeouts/connect failures
# are never replayed. Only explicit 429/408/5xx rejections are retried.
GEMINI_ARCHITECTURE_RETRY_ATTEMPTS=5
GEMINI_RETRY_INITIAL_DELAY_SECONDS=1
GEMINI_RETRY_MAX_DELAY_SECONDS=8
GEMINI_RETRY_EXP_BASE=2
GEMINI_RETRY_JITTER=1

# Smooth simultaneous initial-architecture bursts inside one app worker.
GEMINI_ARCHITECTURE_MAX_CONCURRENCY=1
GEMINI_ARCHITECTURE_QUEUE_TIMEOUT_SECONDS=120

# General non-planner Google GenAI HTTP request boundary. SDK retries remain
# disabled; the staged planner has the explicit-response retry boundary above.
GEMINI_HTTP_TIMEOUT_MS=12000

# --- Docker Compose local stack (docker-compose.yml) ---
# Every value below already has a working default; override only when you need
# to. Compose reads this file both for container environment and for its own
# ${...} interpolation. DATABASE_URL is assembled by docker-compose.yml from
# these values, so setting it here has no effect on the app container.
POSTGRES_USER=archbro
POSTGRES_PASSWORD=archbro
POSTGRES_DB=archbro

# Host port mappings. Change these if 5432 or 8080 are already taken locally.
POSTGRES_PORT=5432
ARCHBRO_PORT=8080
