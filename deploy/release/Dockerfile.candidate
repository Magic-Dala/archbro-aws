# syntax=docker/dockerfile:1.7
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG BASE_IMAGE
ARG ARCHBRO_SOURCE_SHA
ARG ARCHBRO_SOURCE_TREE
ARG ARCHBRO_HARNESS_SHA256=""

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    ARCHBRO_RELEASE_DIR=/app/.archbro-release

WORKDIR /app

# Fail closed: the controller must first resolve the real base manifest digest
# and pass an immutable reference such as python:3.13-slim@sha256:<digest>.
RUN case "${BASE_IMAGE}" in \
      *@sha256:[0-9a-fA-F]* ) ;; \
      * ) echo "BASE_IMAGE must be pinned with @sha256" >&2; exit 64 ;; \
    esac

COPY pyproject.toml README.md LICENSE ./
RUN mkdir -p src/archbro \
    && touch src/archbro/__init__.py \
    && python -m pip install --no-cache-dir . \
    && python -m pip uninstall -y archbro \
    && rm -rf src

COPY src ./src
COPY frontend ./frontend
COPY deploy/release/local_entrypoint.py ./deploy/release/local_entrypoint.py

# The image carries a complete installed dependency manifest plus hashes for
# every runtime source file it actually serves. Git labels alone are therefore
# never the only proof that a target is serving the expected source.
RUN ARCHBRO_BUILD_BASE_IMAGE="${BASE_IMAGE}" \
    ARCHBRO_BUILD_SOURCE_SHA="${ARCHBRO_SOURCE_SHA}" \
    ARCHBRO_BUILD_SOURCE_TREE="${ARCHBRO_SOURCE_TREE}" \
    ARCHBRO_BUILD_HARNESS_SHA256="${ARCHBRO_HARNESS_SHA256}" \
    python - <<'PY'
import hashlib
import importlib.metadata
import json
import os
import re
from pathlib import Path

root = Path("/app")
release_dir = root / ".archbro-release"
release_dir.mkdir(parents=True, exist_ok=True)

source_sha = os.environ["ARCHBRO_BUILD_SOURCE_SHA"].strip()
source_tree = os.environ["ARCHBRO_BUILD_SOURCE_TREE"].strip()
harness_sha = os.environ["ARCHBRO_BUILD_HARNESS_SHA256"].strip() or None
base_ref = os.environ["ARCHBRO_BUILD_BASE_IMAGE"].strip()

git_object = re.compile(r"^[0-9a-fA-F]{40,64}$")
digest_ref = re.compile(r"^[^@\s]+@sha256:[0-9a-fA-F]{64}$")
digest = re.compile(r"^[0-9a-fA-F]{64}$")
if not git_object.fullmatch(source_sha):
    raise SystemExit("ARCHBRO_SOURCE_SHA must be an exact Git object id")
if not git_object.fullmatch(source_tree):
    raise SystemExit("ARCHBRO_SOURCE_TREE must be an exact Git object id")
if not digest_ref.fullmatch(base_ref):
    raise SystemExit("BASE_IMAGE must be pinned with @sha256")
if harness_sha is not None and not digest.fullmatch(harness_sha):
    raise SystemExit("ARCHBRO_HARNESS_SHA256 must be exactly 64 hex digits")

files = []
for relative_root in ("src", "frontend", "deploy/release"):
    for path in sorted((root / relative_root).rglob("*")):
        if not path.is_file():
            continue
        files.append(
            {
                "path": path.relative_to(root).as_posix(),
                "sha256": hashlib.sha256(path.read_bytes()).hexdigest(),
            }
        )
source_manifest = {
    "schema": "archbro.release.source_manifest.v1",
    "files": files,
}
(release_dir / "source-manifest.json").write_text(
    json.dumps(source_manifest, sort_keys=True, separators=(",", ":")),
    encoding="utf-8",
)

packages = []
for distribution in importlib.metadata.distributions():
    name = distribution.metadata.get("Name")
    version = distribution.version
    if name:
        packages.append({"name": name, "version": version})
packages.sort(key=lambda item: (item["name"].lower(), item["version"]))
dependencies = {
    "schema": "archbro.release.dependencies.v1",
    "packages": packages,
}
(release_dir / "dependencies.json").write_text(
    json.dumps(dependencies, sort_keys=True, separators=(",", ":")),
    encoding="utf-8",
)

base_digest = "sha256:" + base_ref.rsplit("@sha256:", 1)[1].lower()
release = {
    "schema": "archbro.release.metadata.v1",
    "source": {
        "git_sha": source_sha.lower(),
        "git_tree": source_tree.lower(),
    },
    "base": {
        "reference": base_ref,
        "manifest_digest": base_digest,
    },
    "harness": {
        "sha256": harness_sha.lower() if harness_sha else None,
    },
    # Image id/manifest digest can only be observed after build. They stay
    # unknown here and are compared by the external 13R/14V inspector.
    "image": {
        "id": None,
        "manifest_digest": None,
    },
}
(release_dir / "release.json").write_text(
    json.dumps(release, sort_keys=True, separators=(",", ":")),
    encoding="utf-8",
)
PY

EXPOSE 8080

CMD ["sh", "-c", "python -m uvicorn archbro.main:app --host 0.0.0.0 --port ${PORT:-8080}"]
